<?xml version="1.0"?>

<!-- This macro adds a convenient TF frame at the tip of the closed gripper. -->
<!-- The position of the TF frame has not been measured at all and needs to be calibrated. -->

<robot name="d435_mount_2f85" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="d435_mount_2f85"
	       params="prefix parent color_camera_centered:=true">

    <xacro:property name="mesh_dir"
		    value="package://aist_description/objects/meshes"/>
    <xacro:if value="${color_camera_centered}">
      <xacro:property name="camera_offset" value="0.0325"/>
    </xacro:if>
    <xacro:unless value="${color_camera_centered}">
      <xacro:property name="camera_offset" value="0.0175"/>
    </xacro:unless>
    
    <link name="${prefix}camera_mount">
      <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${radians(90.0)}"/>
        <mass value="1.0"/>
        <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${radians(90.0)}"/>
        <geometry>
          <mesh filename="${mesh_dir}/d435_mount_2f85.stl"
		scale=".001 .001 .001"/>
        </geometry>
        <material name="white">
          <color rgba="1 1 1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${radians(90.0)}"/>
        <geometry>
          <mesh filename="${mesh_dir}/collision/d435_mount_2f85.stl"
		scale=".001 .001 .001"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}camera_mount_joint" type="fixed">
      <parent link="${parent}" />
      <child  link="${prefix}camera_mount" />
      <origin xyz="-0.002 0.0 0.0335" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}camera_mount_flange"/>
    <joint name="${prefix}camera_mount_flange_joint" type="fixed">
      <parent link="${prefix}camera_mount" />
      <child  link="${prefix}camera_mount_flange" />
      <origin xyz="-0.028 ${camera_offset} 0.0575"
	      rpy="${radians(180.0)} ${radians(15.0)} 0.0"/>
    </joint>

  </xacro:macro>
</robot>
